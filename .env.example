# ---- Global Chat (Neon Postgres) ----
# Paste your Neon connection string here (Neon dashboard -> Connect -> copy the
# "postgresql://..." string). Server-side only: it is never sent to the browser.
# For local dev put it in .env.local; on Vercel add it under
# Settings -> Environment Variables. Never commit the real value.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ---- "Amy" chat widget ----
# Only needed if you want the Amy chat widget enabled.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional -- model pool, comma-separated, first = preferred. If a model is
# rate-limited, overloaded, times out or has been retired, the server silently
# falls back to the next one so chat keeps working. Check current IDs at
# https://ai.google.dev/gemini-api/docs/deprecations (Google retires IDs often).
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash

# Optional -- legacy single-model setting. Still works: it becomes the first
# choice and the defaults are added behind it as backups.
# GEMINI_MODEL=gemini-3.1-flash-lite

# PNRs, practice progress and quiz results still live only in the browser's
# localStorage. The database is used ONLY for the Global Chat tab.
