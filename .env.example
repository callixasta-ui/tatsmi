# Only needed if you want the "GDS Study Buddy" chat widget enabled.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional -- override the default Gemini model
GEMINI_MODEL=gemini-3.1-flash-lite

# The trainer itself needs NO other environment variables -- all PNR/practice
# data is stored in the browser's localStorage only, nothing server-side.
